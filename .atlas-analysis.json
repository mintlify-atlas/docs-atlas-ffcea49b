    "cc-statusline test - Test statusline with real Claude Code JSON input",
    "StatuslineConfig interface - Configuration object structure",
    "generateBashStatusline() - Core bash script generator",
    "--output <path> - Custom output path flag",
    "--no-install - Skip automatic installation flag",
    "installLocation option - Global (~/.claude) or project (./.claude) installation"
